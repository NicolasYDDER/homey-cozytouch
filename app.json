  "flow": {
    "triggers": [
      {
        "id": "measure_temperature_changed",
        "title": {
          "en": "Temperature changed",
          "fr": "Température changée"
        },
        "titleFormatted": {
          "en": "Temperature of [[device]] changed",
          "fr": "Température de [[device]] changée"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "capabilities=measure_temperature"
          }
        ],
        "tokens": [
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature",
              "fr": "Température"
            },
            "example": 21.5
          }
        ]
      },
      {
        "id": "heating_mode_changed",
        "title": {
          "en": "Heating mode changed",
          "fr": "Mode de chauffage changé"
        },
        "titleFormatted": {
          "en": "Heating mode of [[device]] changed",
          "fr": "Mode de chauffage de [[device]] changé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater|water_heater|towel_rack"
          }
        ],
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "example": "manual"
          }
        ]
      },
      {
        "id": "pass_cozytouch_level_changed",
        "title": {
          "en": "Pass Cozytouch mode changed",
          "fr": "Mode Pass Cozytouch changé"
        },
        "titleFormatted": {
          "en": "Pass Cozytouch mode of [[device]] changed",
          "fr": "Mode Pass Cozytouch de [[device]] changé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=pass_cozytouch"
          }
        ],
        "tokens": [
          {
            "name": "level",
            "type": "string",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "example": "comfort"
          }
        ]
      },
      {
        "id": "zone_control_hvac_mode_changed",
        "title": {
          "en": "Zone Control HVAC mode changed",
          "fr": "Mode CVC Zone Control changé"
        },
        "titleFormatted": {
          "en": "Zone Control HVAC mode of [[device]] changed",
          "fr": "Mode CVC Zone Control de [[device]] changé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone_control&capabilities=cozytouch_hvac_mode"
          }
        ],
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "example": "heat"
          }
        ]
      },
      {
        "id": "boost_turned_on",
        "title": {
          "en": "Boost turned on",
          "fr": "Mode boost activé"
        },
        "titleFormatted": {
          "en": "Boost of [[device]] turned on",
          "fr": "Mode boost de [[device]] activé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "capabilities=cozytouch_boost"
          }
        ]
      },
      {
        "id": "boost_turned_off",
        "title": {
          "en": "Boost turned off",
          "fr": "Mode boost désactivé"
        },
        "titleFormatted": {
          "en": "Boost of [[device]] turned off",
          "fr": "Mode boost de [[device]] désactivé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "capabilities=cozytouch_boost"
          }
        ]
      },
      {
        "id": "away_mode_turned_on",
        "title": {
          "en": "Away mode turned on",
          "fr": "Mode absence activé"
        },
        "titleFormatted": {
          "en": "Away mode of [[device]] turned on",
          "fr": "Mode absence de [[device]] activé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "capabilities=cozytouch_away_mode"
          }
        ]
      },
      {
        "id": "away_mode_turned_off",
        "title": {
          "en": "Away mode turned off",
          "fr": "Mode absence désactivé"
        },
        "titleFormatted": {
          "en": "Away mode of [[device]] turned off",
          "fr": "Mode absence de [[device]] désactivé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "capabilities=cozytouch_away_mode"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_heating_mode",
        "title": {
          "en": "Set heating mode",
          "fr": "Définir le mode de chauffage"
        },
        "titleFormatted": {
          "en": "Set heating mode to [[mode]]",
          "fr": "Définir le mode de chauffage sur [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater|water_heater|towel_rack"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off",
                  "fr": "Arrêt"
                }
              },
              {
                "id": "manual",
                "label": {
                  "en": "Manual",
                  "fr": "Manuel"
                }
