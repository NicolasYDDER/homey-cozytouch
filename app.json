  "permissions": [],
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "testConnection": {
      "method": "POST",
      "path": "/test-connection"
    },
    "saveCredentials": {
      "method": "POST",
      "path": "/save-credentials"
    },
    "clearCredentials": {
      "method": "POST",
      "path": "/clear-credentials"
    },
    "saveSyncInterval": {
      "method": "POST",
      "path": "/save-sync-interval"
    }
  },
  "drivers": [
    {
      "id": "heater",
      "name": {
        "en": "Radiator / Heating",
        "fr": "Radiateur / Chauffage"
      },
      "class": "heater",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "cozytouch_heating_mode",
        "onoff"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 5,
          "max": 30,
          "step": 0.5
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "/drivers/heater/assets/icon.svg",
            "title": {
              "en": "Connect to Cozytouch",
              "fr": "Connexion à Cozytouch"
            },
            "usernameLabel": {
              "en": "Cozytouch email",
              "fr": "Email Cozytouch"
            },
            "usernamePlaceholder": {
              "en": "your.email@example.com",
              "fr": "votre.email@exemple.com"
            },
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            },
            "passwordPlaceholder": {
              "en": "Your Cozytouch password",
              "fr": "Votre mot de passe Cozytouch"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/heater/assets/images/small.jpg",
        "large": "/drivers/heater/assets/images/large.jpg",
        "xlarge": "/drivers/heater/assets/images/xlarge.jpg"
